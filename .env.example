# 配置规则：
# 1. 当前 config.py 不提供任何配置回退值，下列键都必须存在。
# 2. 只有 *_API_KEY 和 *_PASSWORD 允许为空；其余必填项不能留空。
# 3. 布尔值支持 true/false、1/0、yes/no、on/off。
# 4. 缺少变量、空值或类型错误时，后端会抛出 ConfigError 并指出变量名。
# 5. 相对路径以后端目录为基准，分隔符建议使用 /。

# Service
# FastAPI 运行参数；CORS_ORIGINS 使用英文逗号分隔。
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Single-user mode: every request uses this identity for all data.
GLOBAL_CLIENT_ID=c57d1c9f-5720-41be-a8ec-11971fedefe7
GLOBAL_TENANT_ID=default-tenant
GLOBAL_USER_ID=c57d1c9f-5720-41be-a8ec-11971fedefe7
# Docker Compose host port for the Nginx frontend
WEB_PORT=8080
# Sibling checkout of web-agent_fronted when running Docker Compose.
FRONTEND_CONTEXT=../frontend

# DeepSeek / OpenAI-compatible chat model
# LLM_API_KEY 为空时聊天模型禁用；地址和模型名仍必须显式配置。
LLM_API_KEY=replace-with-your-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# PostgreSQL
# 密码可留空（例如本地信任认证）；其余连接参数必须填写。
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=agent_db
PG_USERNAME=postgres
PG_PASSWORD=replace-with-database-password
PG_SSLMODE=prefer

# Redis short-term memory (recent session messages)
# 密码可留空；Redis 不可用时后端自动回源 PostgreSQL。
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=replace-with-redis-password
SESSION_TTL_SECONDS=604800
SHORT_TERM_MESSAGE_LIMIT=40
CONVERSATION_RECALL_ENABLED=true
CONVERSATION_RECALL_SCAN=200
CONVERSATION_RECALL_LIMIT=6
CONVERSATION_RECALL_MAX_CHARS=2400

# Qdrant
# API Key 可留空；非空时会作为 api-key 请求头发送。
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=agent_base
QDRANT_API_KEY=
QDRANT_TIMEOUT=10

# Uploaded background and branding media
# 两个媒体目录均相对于 backend/；视频上限单位为 MB。
BACKGROUND_MEDIA_ROOT=data/backgrounds
BRAND_MEDIA_ROOT=data/branding
MAX_BACKGROUND_VIDEO_MB=10240

# Text-to-Speech (本地 CosyVoice2 + RVC 音色转换)
# TTS_ENABLED 控制语音接口是否可用；引擎和模型路径必须配置。
TTS_ENABLED=true
# auto / edge_tts / cosyvoice。auto 默认使用无需模型的 Edge TTS
LOCAL_TTS_ENGINE=auto

# CosyVoice2 TTS 模型目录（可选，本地引擎首次使用时下载）
LOCAL_TTS_MODEL_DIR=models/cosyvoice2
LOCAL_TTS_DEVICE=cuda

# RVC 模型权重目录 (.pth) 和 index 目录 (.index)，分开放置，前端自由选择
LOCAL_RVC_MODEL_DIR=models/rvc/weights
LOCAL_RVC_INDEX_DIR=models/rvc/indexes
LOCAL_RVC_DEVICE=cuda

# 语气参考音频自动识别（可选）。关闭或未配置密钥时回退到本地 Whisper。
# 所有 STT 键仍必须存在；只有 STT_API_KEY 可以为空。
STT_ENABLED=false
# auto 优先使用 CUDA；small 比 tiny 的中文识别更准确
STT_DEVICE=auto
STT_WHISPER_MODEL=small
STT_BASE_URL=https://api.siliconflow.cn/v1
STT_API_KEY=
STT_MODEL=FunAudioLLM/SenseVoiceSmall
STT_TIMEOUT=30

# Embeddings (OpenAI-compatible endpoint)
# 密钥为空时知识库和长期记忆的向量能力禁用；地址和模型名仍必须配置。
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=replace-with-embedding-key
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT=30

# RAG and uploads
# 分数阈值为 0-1；切片重叠应小于 RAG_CHUNK_SIZE。
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.45
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
MAX_UPLOAD_MB=10

# Web crawler (when user supplies a URL in the message)
# 仅抓取用户消息中明确提供的 URL；超时单位为秒。
WEB_CRAWL_ENABLED=true
WEB_CRAWL_TIMEOUT=20
WEB_CRAWL_MAX_CHARS=4000

# Web search
WEB_SEARCH_ENABLED=true
# tavily / serper；留空或未配置 API Key 时使用 Bing
WEB_SEARCH_PROVIDER=bing
WEB_SEARCH_API_KEY=
WEB_SEARCH_TOP_K=5
WEB_SEARCH_TIMEOUT=15

# Long-term memory facts
# 阈值范围 0-1；MEMORY_RECENCY_DAYS 控制事实时效衰减窗口。
MEMORY_ENABLED=true
MEMORY_COLLECTION=user_memory
MEMORY_TOP_K=5
MEMORY_RETRIEVAL_THRESHOLD=0.35
MEMORY_DEDUP_THRESHOLD=0.92
MEMORY_CORRECTION_THRESHOLD=0.68
MEMORY_RECENCY_DAYS=90
MEMORY_MIN_CONFIDENCE=0.60
MEMORY_MAX_FACTS=5
MEMORY_MIN_CONTENT_CHARS=4
MEMORY_MAX_CONTENT_CHARS=800
